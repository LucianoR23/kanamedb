# Rechaza versiones publicadas hace menos de 7 días (10080 minutos), para reducir
# la exposición a releases recién comprometidas o maliciosas.
minimum-release-age=10080

# Excepción: @wailsio/runtime debe coincidir exacto con la versión del módulo Go
# `github.com/wailsapp/wails/v3` o los bindings generados no matchean el runtime.
# Es dependencia de primera parte, pineada a versión exacta, no transitiva.
minimum-release-age-exclude[]=@wailsio/runtime
