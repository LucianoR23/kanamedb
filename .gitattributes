# Normalizar a LF en el repo; el checkout en Windows usa CRLF donde corresponde.
* text=auto eol=lf

# Scripts que corren en Linux/macOS (CI, empaquetado): siempre LF.
*.sh   text eol=lf
build/android/gradlew text eol=lf
# El wrapper de Gradle para Windows es de Gradle, no nuestro: se deja como viene.
build/android/gradlew.bat text eol=crlf

# Binarios
*.png  binary
*.ico  binary
*.icns binary
*.ttf  binary
*.car  binary
*.exe  binary
*.jar  binary
